{
  "name": "tenantforge",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant SaaS starter template",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@tenantforge/api",
    "dev:web": "turbo run dev --filter=@tenantforge/web",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "pnpm --filter @tenantforge/api db:migrate",
    "db:push": "pnpm --filter @tenantforge/api db:push",
    "db:seed": "pnpm --filter @tenantforge/api db:seed",
    "db:studio": "pnpm --filter @tenantforge/api db:studio",
    "db:generate": "pnpm --filter @tenantforge/api db:generate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.29.1",
    "husky": "^9.0.6",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.4",
    "turbo": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
