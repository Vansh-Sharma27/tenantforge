{
  "name": "@tenantforge/api",
  "version": "0.1.0",
  "private": true,
  "description": "TenantForge API Server",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate:keys": "tsx scripts/generate-keys.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.9.0",
    "argon2": "^0.31.2",
    "bullmq": "^5.67.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.2",
    "pino": "^8.18.0",
    "pino-http": "^9.0.0",
    "rate-limit-redis": "^4.3.1",
    "rate-limiter-flexible": "^9.1.0",
    "resend": "^6.9.1",
    "stripe": "^20.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@tenantforge/shared": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^1.2.2",
    "pino-pretty": "^10.3.1",
    "prisma": "^5.9.0",
    "supertest": "^6.3.4",
    "tsx": "^4.7.0",
    "vitest": "^1.2.2"
  }
}
